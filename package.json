{
  "name": "job-agent",
  "version": "0.2.0",
  "description": "Open-source job-search skills for any AI agent: find and score roles, tailor your résumé, fill application forms up to Submit, track and prep. Uses the TrueInterview MCP when connected, your local files when not.",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "setup": "node bin/job-agent.mjs init",
    "scan": "node bin/job-agent.mjs scan",
    "track": "node bin/job-agent.mjs track",
    "pdf": "node bin/job-agent.mjs pdf",
    "kb": "node bin/job-agent.mjs kb",
    "doctor": "node bin/job-agent.mjs doctor",
    "gen:plugins": "node scripts/gen-plugins.mjs",
    "test": "node --test && node scripts/gen-plugins.mjs --check"
  },
  "keywords": [
    "job-search",
    "resume",
    "career",
    "interview-prep",
    "agent-skills",
    "mcp",
    "claude-code",
    "codex",
    "cursor",
    "copilot",
    "gemini-cli"
  ],
  "bin": {
    "job-agent": "bin/job-agent.mjs"
  },
  "files": [
    "bin",
    "scripts",
    "templates",
    "examples",
    "docs",
    "skills",
    "AGENTS.md",
    "LICENSE"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/kevin-2023-code/job-agent.git"
  }
}
